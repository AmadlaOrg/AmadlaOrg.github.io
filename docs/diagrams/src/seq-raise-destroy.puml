@startuml seq-raise-destroy

title raise destroy — Remove Infrastructure

skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #444

actor "User" as user
participant "cmd/" as cmd
participant "plugin/" as plug
participant "raise-<provider>" as pl
participant "Filesystem" as fs

== Delegate to plugin ==

user -> cmd : raise destroy [name] --provider <p>
cmd -> plug : Exec("raise-" + provider,\n["destroy", name])
plug -> fs : exec.LookPath("raise-<provider>")
plug -> pl : spawn subprocess,\nwire stdin/stdout/stderr
pl -> fs : remove VM + disks,\ndrop entry from state file\n(~/.local/share/raise/<provider>/state.json)
pl --> plug : exit code
plug --> cmd : code
cmd --> user : plugin output passed through\nraise exits with plugin's code

== Errors ==

user -> cmd : raise destroy (no --provider)
cmd --> user : required flag "provider" not set\non stderr, exit 1
user -> cmd : plugin binary not in PATH
cmd --> user : "plugin raise-<provider> not found in PATH"\non stderr, exit 1

@enduml
