@startuml seq-pipeline-flow

title Amadla — Pipeline Execution Flow

skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #444

actor "DevOps Engineer" as user
participant "amadla" as amadla
participant "hery" as hery
participant "doorman" as doorman
participant "raise" as raise
participant "lay" as lay
participant "enjoin" as enjoin
participant "weaver" as weaver
participant "judge" as judge
database "YAML files" as yaml
database "Secret Stores" as secrets
participant "Cloud Provider" as cloud

== 1. Plan the run ==

user -> amadla : amadla run ./entities
amadla -> hery : Query entities
hery -> yaml : Read .hery entities
yaml --> hery : Entity data
hery -> hery : Validate against\nJSON Schema
hery --> amadla : JSON: entity data
amadla -> amadla : Build DAG from _requires,\ntopologically sort

== 2. Resolve Secrets ==

amadla -> doorman : Secret entities
doorman -> secrets : Fetch via\ndoorman-* plugins
secrets --> doorman : Secret values
doorman --> amadla : JSON: data + secrets

== 3. Provision Infrastructure ==

amadla -> raise : Infrastructure entities
raise -> cloud : Create servers,\nnetworks, storage
cloud --> raise : Provisioned resources
raise --> amadla : JSON: infra details

== 4. Install Applications ==

amadla -> lay : Package, Application,\nProgrammingLanguage entities
lay -> lay : Install via package\nmanagers per platform
lay --> amadla : JSON: installed apps

== 5. Configure the System ==

amadla -> enjoin : User, Service, Cron,\nSystem/*, Security/* entities
enjoin -> enjoin : Apply state via\nenjoin-* plugins
enjoin --> amadla : JSON: configured system

== 6. Generate Configuration ==

amadla -> weaver : Template entities
weaver -> weaver : Render templates\nwith entity data
weaver --> amadla : Generated config files

== 7. Audit State ==

amadla -> judge : Validation entities
judge -> judge : Run judge-* plugins
judge --> amadla : Compliance report\n(pass/fail per check)
amadla --> user : Run summary

@enduml
