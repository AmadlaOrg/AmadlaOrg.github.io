@startuml c2-plugin-architecture
!pragma layout smetana
!define RELATIVE_INCLUDE ""
!include ../vendor/C4-PlantUML/C4_Container.puml

title Amadla — Plugin Architecture (C2)

System_Boundary(doorman_system, "doorman + Doorman Plugins") {
    Container(doorman, "doorman", "Go CLI", "Secrets management")
    Container(dm_vault, "doorman-vault", "Go Plugin", "Vault / OpenBao")
    Container(dm_aws, "doorman-aws", "Go Plugin", "AWS Secrets Manager")
    Container(dm_kpxc, "doorman-keepassxc", "Go Plugin", "KeePassXC")
    Container(dm_kc, "doorman-keycloak", "Go Plugin", "Keycloak tokens")
}

System_Boundary(raise_system, "raise + Provider Plugins") {
    Container(raise, "raise", "Go CLI", "Infrastructure provisioner")
    Container(rs_libvirt, "raise-libvirt", "Go Plugin", "KVM / libvirt")
    Container(rs_vbox, "raise-virtualbox", "Go Plugin", "VirtualBox")
    Container(rs_aws, "raise-aws", "Go Plugin", "AWS EC2")
    Container(rs_tofu, "raise-opentofu", "Go Plugin", "OpenTofu / Terraform")
}

System_Boundary(enjoin_system, "enjoin + System State Plugins") {
    Container(enjoin, "enjoin", "Go CLI", "System state configuration")
    Container(ej_user, "enjoin-user", "Go Plugin", "User accounts")
    Container(ej_service, "enjoin-service", "Go Plugin", "System services")
    Container(ej_firewall, "enjoin-firewall", "Go Plugin", "Firewall rules")
    Container(ej_cron, "enjoin-cron", "Go Plugin", "Scheduled tasks")
}

System_Boundary(judge_system, "judge + Judge Plugins") {
    Container(judge, "judge", "Go CLI", "Audit orchestrator")
    Container(jd_app, "judge-application", "Go Plugin", "Package checks")
    Container(jd_sys, "judge-system", "Go Plugin", "System checks")
    Container(jd_infra, "judge-infrastructure", "Go Plugin", "Infra checks")
}

System_Boundary(weaver_system, "weaver + Template Engines") {
    Container(weaver, "weaver", "Go CLI", "Template generator")
    Container(wvr_jinja, "weaver-jinja", "Plugin", "Jinja2 engine")
    Container(wvr_hbs, "weaver-js-handlebars", "Plugin", "Handlebars engine")
    Container(wvr_mst, "weaver-js-mustache", "Plugin", "Mustache engine")
    Container(wvr_qute, "weaver-qute", "Plugin", "Qute engine")
}

Rel(doorman, dm_vault, "Plugin protocol")
Rel(doorman, dm_aws, "Plugin protocol")
Rel(doorman, dm_kpxc, "Plugin protocol")
Rel(doorman, dm_kc, "Plugin protocol")

Rel(raise, rs_libvirt, "Plugin protocol")
Rel(raise, rs_vbox, "Plugin protocol")
Rel(raise, rs_aws, "Plugin protocol")
Rel(raise, rs_tofu, "Plugin protocol")

Rel(enjoin, ej_user, "Plugin protocol")
Rel(enjoin, ej_service, "Plugin protocol")
Rel(enjoin, ej_firewall, "Plugin protocol")
Rel(enjoin, ej_cron, "Plugin protocol")

Rel(judge, jd_app, "Plugin protocol")
Rel(judge, jd_sys, "Plugin protocol")
Rel(judge, jd_infra, "Plugin protocol")

Rel(weaver, wvr_jinja, "Plugin protocol")
Rel(weaver, wvr_hbs, "Plugin protocol")
Rel(weaver, wvr_mst, "Plugin protocol")
Rel(weaver, wvr_qute, "Plugin protocol")

@enduml
