@startuml c3-doorman-internals
!pragma layout smetana
!define RELATIVE_INCLUDE ""
!include ../vendor/C4-PlantUML/C4_Component.puml

title doorman — Internal Components (C3)

Container_Boundary(doorman, "doorman") {
    Component(main, "main.go", "Entry Point", "Wires the root\nCobra command")

    Component(cmd_get, "cmd/get.go", "Cobra Command", "doorman get <key>\n--from <plugin>")

    Component(cmd_plugins, "cmd/plugins.go", "Cobra Command", "doorman plugins:\nlists what was found")

    Component(plugin, "plugin/", "Plugin Service", "Discovers doorman-*\nbinaries on PATH,\nexecutes them, reads\ntheir JSON output")
}

System_Boundary(doorman_plugins, "Doorman Plugins") {
    Component(dm_vault, "doorman-vault", "Go CLI", "HashiCorp Vault\n/ OpenBao")
    Component(dm_bitwarden, "doorman-bitwarden", "Go CLI", "Bitwarden /\nVaultwarden")
    Component(dm_keepassxc, "doorman-keepassxc", "Go CLI", "KeePassXC")
}

System_Ext(path, "PATH", "Where plugin binaries\nare discovered")
System_Ext(vault, "Vault / OpenBao", "Secret store")
System_Ext(bitwarden, "Bitwarden", "Secret store")
System_Ext(keepassxc, "KeePassXC", "Password manager")
System_Ext(caller, "Caller", "Pipeline tool or\nuser shell")

Rel(caller, cmd_get, "doorman get")
Rel(caller, cmd_plugins, "doorman plugins")
Rel(main, cmd_get, "Registers")
Rel(main, cmd_plugins, "Registers")
Rel(cmd_get, plugin, "Get(plugin, key)")
Rel(cmd_plugins, plugin, "Discover()")
Rel(plugin, path, "Scans for doorman-*")
Rel(plugin, dm_vault, "Executes, reads JSON")
Rel(plugin, dm_bitwarden, "Executes, reads JSON")
Rel(plugin, dm_keepassxc, "Executes, reads JSON")
Rel(dm_vault, vault, "API call")
Rel(dm_bitwarden, bitwarden, "API call")
Rel(dm_keepassxc, keepassxc, "Database / D-Bus")

@enduml
