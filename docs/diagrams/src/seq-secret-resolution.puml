@startuml seq-secret-resolution

title Amadla — Secret Resolution Flow

skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #444

actor "Caller\n(pipeline or shell)" as caller
participant "doorman" as doorman
participant "plugin/\nservice" as service
participant "doorman-vault\n(binary on PATH)" as plugin
database "Vault /\nOpenBao" as vault

== Discovering plugins ==

caller -> doorman : doorman plugins
doorman -> service : Discover()
service -> service : Scan each PATH entry\nfor doorman-* binaries
service -> plugin : doorman-vault info
plugin --> service : JSON: name, version,\nengine, supports
service --> doorman : Plugin list
doorman --> caller : Available plugins

== Retrieving a secret ==

caller -> doorman : doorman get db/password\n--from vault
doorman -> service : Get("doorman-vault",\n"db/password")
service -> service : Look up doorman-vault\non PATH
service -> plugin : Execute with the key
plugin -> vault : Read secret
vault --> plugin : Secret value
plugin --> service : JSON on stdout
service --> doorman : Streamed through
doorman --> caller : Secret value on stdout

== Plugin missing ==

caller -> doorman : doorman get api/key\n--from nomad
doorman -> service : Get("doorman-nomad",\n"api/key")
service -> service : Look up doorman-nomad\non PATH
service --> doorman : error: plugin not found\nin PATH
doorman --> caller : Non-zero exit,\nerror on stderr

@enduml
